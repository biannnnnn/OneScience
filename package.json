{
  "name": "onescience-submission-agent",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "server": "node server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test",
    "setup:markitdown": "bash scripts/pdf/setup-markitdown.sh",
    "preflight:current-review": "node scripts/current-review/preflight.mjs",
    "smoke:current-review": "node scripts/current-review/smoke.mjs",
    "evaluate:deepseek-vs-naipv2": "node scripts/current-review/evaluate-deepseek-vs-naipv2.mjs",
    "evaluate:deepseek-ranking-protocols": "node scripts/current-review/evaluate-deepseek-ranking-protocols.mjs",
    "evaluate:deepseek-ranking-audit": "node scripts/current-review/audit-deepseek-ranking-stability.mjs evaluation/deepseek-vs-naipv2/runs",
    "evaluate:deepseek-listwise-summary": "node scripts/current-review/summarize-deepseek-dual-listwise.mjs",
    "venue-tier:collect": "node scripts/venue-tier-evaluation/collect-openalex.mjs",
    "venue-tier:sync-ccf-international": "node scripts/venue-tier-evaluation/sync-ccf-international.mjs",
    "venue-tier:prepare": "node scripts/venue-tier-evaluation/prepare.mjs",
    "venue-tier:score": "node scripts/venue-tier-evaluation/run-ranker.mjs",
    "venue-tier:score-large": "node scripts/venue-tier-evaluation/run-large-model-pairwise.mjs",
    "venue-tier:evaluate-large": "node scripts/venue-tier-evaluation/evaluate-large-model.mjs",
    "venue-tier:evaluate-large-dual": "node scripts/venue-tier-evaluation/evaluate-large-dual-orientation.mjs",
    "venue-tier:evaluate": "node scripts/venue-tier-evaluation/evaluate.mjs",
    "venue-tier:compare-models": "node scripts/venue-tier-evaluation/evaluate-model-comparison.mjs",
    "ranker:mock": "python3 -m ranker_service.app --config config/ranker-service.mock.json --backend mock",
    "ranker:serve": "bash scripts/naipv2/serve_ranker.sh",
    "ranker:fulltext:serve": "bash scripts/naipv2/serve_fulltext_ranker.sh",
    "ranker:calibrate": "bash scripts/naipv2/build_ranker_calibration.sh",
    "ranker:small:bootstrap": "bash scripts/naipv2/bootstrap_small_model_runtime.sh",
    "ranker:small:train:3b": "bash scripts/naipv2/run_small_model_experiment.sh qwen25-3b",
    "ranker:small:train:0.6b": "bash scripts/naipv2/run_small_model_experiment.sh qwen3-0.6b",
    "ranker:small:compare": "python3 scripts/naipv2/compare_small_model_runs.py --baseline evaluation/naipv2-official/runs/retrained-paper-faithful-seed42-public-test/metrics.json --run qwen25-3b=evaluation/naipv2-small-models/runs/qwen25-3b-naipv2-seed42-public-test/metrics.json --run qwen3-0.6b=evaluation/naipv2-small-models/runs/qwen3-0.6b-naipv2-seed42-public-test/metrics.json --out evaluation/naipv2-small-models/comparison.json",
    "ranker:fulltext:prepare": ".venv-server/bin/python scripts/naipv2/prepare_fulltext_evidence.py --train-parquet data/openreview/external/proreview/data/train-00000-of-00001.parquet --test-parquet data/openreview/external/proreview/data/test-00000-of-00001.parquet --output-dir data/naipv2-fulltext-evidence",
    "ranker:fulltext:train:8b": "bash scripts/naipv2/run_fulltext_ranker_experiment.sh llama3-8b",
    "ranker:fulltext:train:3b": "bash scripts/naipv2/run_fulltext_ranker_experiment.sh qwen25-3b",
    "ranker:fulltext:train:0.6b": "bash scripts/naipv2/run_fulltext_ranker_experiment.sh qwen3-0.6b",
    "ranker:fulltext:train:suite": "bash scripts/naipv2/run_fulltext_ranker_suite.sh",
    "ranker:fulltext:compare": "python3 scripts/naipv2/compare_fulltext_rankers.py --run 8B=evaluation/naipv2-fulltext-rankers/runs/llama3-8b-fulltext-evidence-seed42-heldout/metrics.json --run 3B=evaluation/naipv2-fulltext-rankers/runs/qwen25-3b-fulltext-evidence-seed42-heldout/metrics.json --run 0.6B=evaluation/naipv2-fulltext-rankers/runs/qwen3-0.6b-fulltext-evidence-seed42-heldout/metrics.json --out evaluation/naipv2-fulltext-rankers/comparison.json",
    "data:openreview:collect": "node scripts/openreview/collect.mjs",
    "data:openreview:clean": "node scripts/openreview/clean.mjs",
    "data:openreview:split": "node scripts/openreview/split.mjs",
    "baseline:preflight": "node scripts/reviewer-baseline/preflight.mjs --config config/reviewer-baseline.m1.json",
    "baseline:prepare": "node scripts/reviewer-baseline/prepare.mjs",
    "baseline:dry": ".venv-mlx/bin/python scripts/reviewer-baseline/run_mlx.py --dry-run",
    "baseline:run": ".venv-mlx/bin/python scripts/reviewer-baseline/run_mlx.py",
    "baseline:evaluate": "node scripts/reviewer-baseline/evaluate.mjs",
    "reviewer:mock": ".venv-mlx/bin/python -m reviewer_service.app --config config/reviewer-service.m1.json --backend mock",
    "reviewer:serve": ".venv-mlx/bin/python -m reviewer_service.app --config config/reviewer-service.m1.json --backend mlx",
    "reviewer:train:prepare": ".venv-mlx/bin/python scripts/reviewer-training/prepare_proreview.py",
    "reviewer:train:prepare-schema": ".venv-mlx/bin/python scripts/reviewer-training/prepare_schema_alignment.py",
    "reviewer:train:smoke": ".venv-mlx/bin/python -m mlx_lm lora --config config/reviewer-lora-smoke.m1.yaml",
    "reviewer:train:schema-smoke": ".venv-mlx/bin/python -m mlx_lm lora --config config/reviewer-lora-schema-smoke.m1.yaml",
    "reviewer:serve:trained-smoke": ".venv-mlx/bin/python -m reviewer_service.app --config config/reviewer-service.m1.json --backend mlx --model-config config/reviewer-baseline-openreview-smoke.m1.json",
    "reviewer:serve:schema-smoke": ".venv-mlx/bin/python -m reviewer_service.app --config config/reviewer-service.m1.json --backend mlx --model-config config/reviewer-baseline-openreview-schema-step10.m1.json",
    "reviewer:server:prepare-eval": ".venv-server/bin/python scripts/reviewer-server/prepare-heldout-eval.py",
    "reviewer:server:evaluate": ".venv-server/bin/python scripts/reviewer-server/run-openai-eval.py",
    "acceptance:prepare": ".venv-mlx/bin/python scripts/acceptance-prediction/prepare_proreview.py",
    "acceptance:review-features": ".venv-mlx/bin/python scripts/acceptance-prediction/run_reviews.py",
    "acceptance:train": ".venv-mlx/bin/python scripts/acceptance-prediction/train.py",
    "acceptance:predict": ".venv-mlx/bin/python scripts/acceptance-prediction/predict.py",
    "acceptance:server:review-features": ".venv-server/bin/python scripts/acceptance-prediction/run_reviews.py",
    "acceptance:server:train": ".venv-server/bin/python scripts/acceptance-prediction/train.py",
    "acceptance:server:predict": ".venv-server/bin/python scripts/acceptance-prediction/predict.py"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "multer": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
