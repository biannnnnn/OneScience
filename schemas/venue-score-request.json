{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onescience.local/schemas/venue-score-request-1.0.0.json",
  "title": "OneScience Venue Score Batch Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_language", "target_venue", "papers"],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "review_language": { "enum": ["zh-CN", "en"] },
    "target_venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": { "type": ["string", "null"], "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "scope": { "type": ["string", "null"], "maxLength": 5000 },
        "requirements": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "scope_source": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 },
        "scope_checked_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "title", "input_type", "language", "text"],
        "properties": {
          "paper_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "input_type": { "enum": ["manuscript", "abstract"] },
          "language": { "type": "string", "minLength": 2, "maxLength": 32 },
          "text": { "type": "string", "minLength": 20, "maxLength": 24000 }
        }
      }
    }
  }
}
