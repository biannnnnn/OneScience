{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onescience.local/schemas/venue-score-1.0.0.json",
  "title": "OneScience Venue Score (single paper)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "originality",
    "rigor",
    "evidence",
    "clarity",
    "reproducibility",
    "venue_fit",
    "overall",
    "confidence",
    "rationale",
    "strengths",
    "risks",
    "limitations"
  ],
  "properties": {
    "originality": { "type": "number", "minimum": 0, "maximum": 100 },
    "rigor": { "type": "number", "minimum": 0, "maximum": 100 },
    "evidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "clarity": { "type": "number", "minimum": 0, "maximum": 100 },
    "reproducibility": { "type": "number", "minimum": 0, "maximum": 100 },
    "venue_fit": { "type": "number", "minimum": 0, "maximum": 100 },
    "overall": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 600 },
    "strengths": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "risks": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
