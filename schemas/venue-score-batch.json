{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onescience.local/schemas/venue-score-batch-1.0.0.json",
  "title": "OneScience Venue Score Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "target_venue", "scores", "model_trace", "disclaimer"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "target_venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": { "type": ["string", "null"], "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_id", "title", "input_type", "originality", "rigor", "evidence", "clarity", "reproducibility", "venue_fit", "overall", "confidence", "rationale", "strengths", "risks", "limitations"],
        "properties": {
          "paper_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "input_type": { "enum": ["manuscript", "abstract"] },
          "originality": { "type": "number", "minimum": 0, "maximum": 100 },
          "rigor": { "type": "number", "minimum": 0, "maximum": 100 },
          "evidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "clarity": { "type": "number", "minimum": 0, "maximum": 100 },
          "reproducibility": { "type": "number", "minimum": 0, "maximum": 100 },
          "venue_fit": { "type": "number", "minimum": 0, "maximum": 100 },
          "overall": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 600 },
          "strengths": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "risks": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "limitations": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
        }
      }
    },
    "model_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "model_version", "adapter_version", "prompt_version", "quantization", "generated_at", "latency_ms"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": ["string", "null"] },
        "prompt_version": { "type": "string", "minLength": 1 },
        "quantization": { "type": ["string", "null"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "disclaimer": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
