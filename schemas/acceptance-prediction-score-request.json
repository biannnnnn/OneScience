{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onescience.local/schemas/acceptance-prediction-score-request-1.0.0.json",
  "title": "OneScience Acceptance Prediction Score Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["manuscript", "target_venue", "score", "model_trace"],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "paragraphs"],
      "properties": {
        "paper_id": { "type": ["string", "null"], "maxLength": 256 },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "language": { "type": "string", "minLength": 2, "maxLength": 32 },
        "fingerprint": { "type": ["string", "null"], "maxLength": 128 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "paragraph_id", "text"],
            "properties": {
              "section": { "type": "string", "minLength": 1, "maxLength": 300 },
              "paragraph_id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
            }
          }
        }
      }
    },
    "target_venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": { "type": ["string", "null"], "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "scope": { "type": ["string", "null"], "maxLength": 5000 },
        "requirements": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "scope_source": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 },
        "scope_checked_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originality",
        "rigor",
        "evidence",
        "clarity",
        "reproducibility",
        "venue_fit",
        "overall",
        "confidence",
        "rationale",
        "strengths",
        "risks",
        "limitations"
      ],
      "properties": {
        "originality": { "type": "number", "minimum": 0, "maximum": 100 },
        "rigor": { "type": "number", "minimum": 0, "maximum": 100 },
        "evidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "clarity": { "type": "number", "minimum": 0, "maximum": 100 },
        "reproducibility": { "type": "number", "minimum": 0, "maximum": 100 },
        "venue_fit": { "type": "number", "minimum": 0, "maximum": 100 },
        "overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 600 },
        "strengths": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "risks": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "model_trace": {
      "type": "object",
      "required": ["model", "model_version", "adapter_version", "prompt_version"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": ["string", "null"] },
        "prompt_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
