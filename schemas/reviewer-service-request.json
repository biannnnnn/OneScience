{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onescience.local/schemas/reviewer-service-request-1.0.0.json",
  "title": "OneScience Reviewer Service Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_type", "review_language", "manuscript", "target_venue"],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "review_type": {
      "enum": ["general", "venue_conditioned"]
    },
    "review_language": {
      "enum": ["zh-CN", "en"]
    },
    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "paragraphs"],
      "properties": {
        "paper_id": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "fingerprint": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "paragraph_id", "text"],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "paragraph_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            }
          }
        }
      }
    },
    "target_venue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "id": { "type": ["string", "null"], "maxLength": 128 },
            "name": { "type": "string", "minLength": 1, "maxLength": 500 },
            "scope": { "type": ["string", "null"], "maxLength": 5000 },
            "requirements": {
              "type": "array",
              "maxItems": 30,
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            },
            "scope_source": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 },
            "scope_checked_at": { "type": ["string", "null"], "format": "date" }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "review_type": { "const": "venue_conditioned" } },
        "required": ["review_type"]
      },
      "then": {
        "properties": { "target_venue": { "type": "object" } }
      },
      "else": {
        "properties": { "target_venue": { "type": "null" } }
      }
    }
  ]
}
